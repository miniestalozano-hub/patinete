# ============================================
# VARIABLES DE ENTORNO - patin-shop
# Copia este archivo como ".env" y rellena los valores reales.
# NUNCA subas el archivo ".env" a git.
# ============================================

# --- Base de datos (Supabase Postgres) ---
# Se obtiene en Supabase > Project Settings > Database > Connection string
# Usa el "Connection pooling" (puerto 6543) para DATABASE_URL en produccion
# y la conexion directa (puerto 5432) para DIRECT_URL (usada por las migraciones).
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# --- Supabase (Auth + Storage) ---
# Se obtienen en Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-publica"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-secreta"

# --- Stripe (pagos) ---
# Se obtienen en Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxx"
# Se genera al crear el webhook endpoint en Stripe (stripe listen o dashboard)
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxx"

# --- Aplicacion ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Clave secreta usada para proteger rutas de administracion / cron jobs
ADMIN_API_SECRET="genera-una-cadena-aleatoria-segura"

# --- Email transaccional (opcional, ej. Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="Tienda Patinetes <pedidos@tudominio.com>"
